{
  "name": "crewsync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js",
    "client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "npm run test:unit && npm run test:integration",
    "check": "node --check server/app.js && node --check server/service.js",
    "demo": "node server/local-demo.js",
    "test:unit": "node --test tests/validation.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/workflows.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0",
    "mongodb-memory-server": "^11.3.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
